VITE_API_BASE_URL=

# 개발 환경에서 실제 API 응답을 수집할 때만 true
# 자세한 내용: docs/api-mocking/README.md
VITE_RECORD_API=false

# 로컬 CORS 우회용. 설정하면 dev 서버가 /api 요청을 대신 호출한다
# 사용 시 VITE_API_BASE_URL 은 비워 둔다
VITE_API_PROXY_TARGET=

# 백엔드 없이 목 API로 실행한다.
# 로컬 개발과 데모 배포(allway-demo.vercel.app)에서 사용한다.
#
# 주의: true 이면 PWA 가 비활성화된다.
# MSW 워커와 Workbox 워커가 같은 스코프를 두고 충돌하기 때문이다.
# 자세한 내용: docs/api-mocking/README.md
VITE_USE_MOCK_API=false
